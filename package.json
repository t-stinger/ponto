{
  "name": "repeat-work-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.ts tests/compare.test.ts tests/ai-contract.test.ts tests/ai-server.test.ts tests/flexible.test.ts tests/outputs.test.ts",
    "verify:core": "npm run typecheck && npm test",
    "demo:core": "node scripts/demo-core.ts",
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4180 --strictPort",
    "build": "npm run typecheck && vite build",
    "test:browser": "playwright test",
    "start": "node --env-file-if-exists=.env src/server/index.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "papaparse": "5.7.0",
    "pdf-lib": "^1.17.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1",
      "unzipper": "0.12.3"
    }
  },
  "license": "MIT"
}
